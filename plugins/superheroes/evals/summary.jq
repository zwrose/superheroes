.cases[] | .name as $n | (.arms | to_entries[]) | .key as $arm | .value as $runs |
  "\($n)\t\($arm)\tpass \([$runs[] | select(.error == null and ([.graders[] | select((.name | startswith("diag-")) | not) | .passed] | length > 0 and all))] | length)/\($runs | length)\tcost $\([$runs[].costUsd] | add * 100 | round / 100)\tdiag \([$runs[] | select([.graders[] | select(.name | startswith("diag-")) | .passed] | any)] | length)/\($runs | length)\tfails: \([$runs[].graders[] | select(.passed | not) | select(.name | startswith("diag-") | not) | .name] | unique | join(","))\(if [$runs[].error] | any then "\terror: " + ([$runs[].error | select(.)] | join(";"))[0:120] else "" end)"
