# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Internal design docs stay local — EXCEPT definition-docs (specs + work-item folders),
# which are committed (doc-policy confirmed 2026-08-08: docs/superheroes, visibility committed).
# `docs/*` + negation rather than `docs/` because git cannot re-include under an excluded dir.
docs/*
!docs/superheroes/

# Python test/coverage artifacts
.coverage
.coverage.*
htmlcov/

# subagent-driven-development scratch (build-local)
.superpowers/

# review-crew store — lives in the machine-local global store, never in-repo
.claude/review-decisions.json
.claude/review-profile.md
