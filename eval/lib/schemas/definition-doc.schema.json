{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "superheroes/definition-doc-frontmatter",
  "title": "superheroes definition-doc frontmatter (CONVENTIONS §3.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["superheroes", "schemaVersion", "docType", "workItem", "issue", "size", "status", "gates", "producedBy", "created", "updated"],
  "if": {"properties": {"gates": {"properties": {"review": {"const": "passed"}}, "required": ["review"]}}, "required": ["gates"]},
  "then": {"required": ["approved"]},
  "else": {"not": {"required": ["approved"]}},
  "dependencies": {"delivered": ["deliveryReceipt", "livesIn"], "deliveryReceipt": ["delivered"], "livesIn": ["delivered"], "supersededInPart": ["delivered"]},
  "allOf": [{"if": {"required": ["delivered"]}, "then": {"properties": {"gates": {"properties": {"review": {"const": "passed"}}}}}}],
  "properties": {
    "superheroes": { "const": "doc" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "docType": { "enum": ["spec", "plan", "tasks"] },
    "workItem": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-[0-9a-f]{6}$" },
    "issue": { "type": ["integer", "null"] },
    "size": { "enum": ["small", "medium", "large"] },
    "status": { "enum": ["draft", "in-review", "approved"] },
    "approved": { "type": "string", "format": "date" },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review"],
      "properties": {
        "review": { "enum": ["pending", "passed", "changes-requested"] }
      }
    },
    "producedBy": { "type": "string" },
    "created": { "type": "string" },
    "updated": { "type": "string" },
    "delivered": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "deliveryReceipt": { "type": "string", "pattern": "^https?://\\S+$" },
    "livesIn": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "supersededInPart": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "sections", "ruling"],
        "properties": {
          "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "sections": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "ruling": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
